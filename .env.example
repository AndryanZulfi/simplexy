DATABASE_URL=postgres://simplexy:***@localhost:5432/simplexy
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=simplexy-dev-secret
SIMPLEXY_TOOL_ACTION_SIGNING_SECRET=simplexy-dev-tool-action-signing-secret-change-me
SIMPLEXY_SENTRY_RUN_FAILURES=off

# Network & Host configuration
SIMPLEXY_PUBLIC_URL=http://localhost:3100
SIMPLEXY_ALLOWED_HOSTNAMES=localhost,127.0.0.1
SIMPLEXY_DEPLOYMENT_MODE=authenticated
SIMPLEXY_DEPLOYMENT_EXPOSURE=private
SIMPLEXY_AUTH_DISABLE_SIGN_UP=false

# Local workspace agents configuration
SIMPLEXY_LOCAL_AGENTS_ENABLED=true
SIMPLEXY_LOCAL_PI_COMMAND=/Users/idn/.nvm/versions/node/v24.21.0/bin/pi
SIMPLEXY_LOCAL_HERMES_COMMAND=/Users/idn/.hermes/hermes-agent/.hermes/bin/hermes
SIMPLEXY_LOCAL_GATEWAY_URL=http://127.0.0.1:20128/v1
SIMPLEXY_LOCAL_GATEWAY_API_KEY=<operator-secret>
SIMPLEXY_LOCAL_PI_MODEL=ag/gemini-3.8-flash
SIMPLEXY_LOCAL_PI_PROVIDERS={"simplexy":{"baseUrl":"http://127.0.0.1:20128/v1","api":"openai-completions","apiKey":"<operator-secret>","models":[{"id":"ag/gemini-3.8-flash","name":"Gemini Flash"}]}}

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
